 "fiscalNoteHTML": "<html><head><meta http-equiv=\"Content-Type\" content=\"text/html; charset=utf-8\" /><meta http-equiv=\"Content-Style-Type\" content=\"text/css\" /><meta name=\"generator\" content=\"Aspose.Words for .NET 23.4.0\" /><title>Fiscal Note - 26LSO-0208</title></head><body style=\"font-family:'Courier New'; font-size:11pt\"><div><div style=\"-aw-headerfooter-type:header-primary; clear:both\"><table cellspacing=\"0\" cellpadding=\"0\" style=\"border-collapse:collapse\"><tr><td style=\"width:296.1pt; padding-right:5.4pt; padding-left:5.4pt; vertical-align:top\"><p style=\"margin-top:0pt; margin-bottom:0pt; font-size:11pt\"><span>Prohibiting unauthorized atmospheric geoengineering.</span></p></td><td style=\"width:197.1pt; padding-right:5.4pt; padding-left:5.4pt; vertical-align:top\"><p style=\"margin-top:0pt; margin-bottom:0pt; text-align:right; font-size:11pt\"><span>26LSO-0208, 0.5</span></p></td></tr></table><p style=\"margin-top:0pt; margin-bottom:0pt\"><span style=\"width:216pt; display:inline-block; -aw-tabstop-align:center; -aw-tabstop-pos:216pt\">&#xa0;</span><span style=\"width:216pt; display:inline-block; -aw-tabstop-align:right; -aw-tabstop-pos:432pt\">&#xa0;</span></p></div><p style=\"margin-top:0pt; margin-bottom:0pt; text-align:center\"><span style=\"font-weight:bold; text-decoration:underline\">FISCAL NOTE</span></p><p style=\"margin-top:0pt; margin-bottom:0pt\"><span style=\"-aw-import:ignore\">&#xa0;</span></p><p style=\"margin-top:0pt; margin-bottom:0pt\"><span style=\"-aw-import:ignore\">&#xa0;</span></p><p style=\"margin-top:0pt; margin-bottom:0pt\"><span>No fiscal or personnel impact.</span></p><div style=\"-aw-headerfooter-type:footer-primary; clear:both\"><p style=\"margin-top:0pt; margin-bottom:0pt\"><span style=\"width:216pt; display:inline-block; -aw-tabstop-align:center; -aw-tabstop-pos:216pt\">&#xa0;</span><span style=\"width:216pt; display:inline-block; -aw-tabstop-align:right; -aw-tabstop-pos:432pt\">&#xa0;</span><span style